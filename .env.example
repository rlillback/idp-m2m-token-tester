# Starter settings for idp-m2m-token-tester.
#   cp .env.example .env && chmod 600 .env
# Fill in ONLY the IdP section you use. Delete the rest.
# Real environment variables override this file. Anything left unset is prompted for.
# SECURITY: leave *_CLIENT_SECRET blank (or remove the line) to be prompted instead of
# storing it in plaintext. Never commit .env.

# ---- Auth0 ----
AUTH0_DOMAIN=your-tenant.us.auth0.com
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
AUTH0_AUDIENCE=https://your-api-identifier
# AUTH0_SCOPE=

# ---- Microsoft Entra ID ----
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
# Default is api://<client_id>/.default
# ENTRA_SCOPE=

# ---- Keycloak ----
KC_BASE=https://keycloak.example.com
KC_REALM=your-realm
KC_CLIENT_ID=
KC_CLIENT_SECRET=
# KC_SCOPE=

# ---- Okta ----
OKTA_DOMAIN=your-org.okta.com
OKTA_CLIENT_ID=
OKTA_CLIENT_SECRET=
# Okta requires a scope
OKTA_SCOPE=
# "default", a custom server ID, or "org" for the org authorization server
# OKTA_AUTH_SERVER=default
# client_secret_post (default) or client_secret_basic
# OKTA_AUTH_METHOD=client_secret_post

# ---- Ping Identity ----
# pingone (default) or pingfederate
PING_FLAVOR=pingone
PING_CLIENT_ID=
PING_CLIENT_SECRET=
# PING_SCOPE=
# PING_AUTH_METHOD=client_secret_post
# PingOne:
PING_ENV_ID=
# PING_REGION=com
# PingFederate (set PING_FLAVOR=pingfederate), host[:port]:
# PING_HOST=pf.example.com:9031
